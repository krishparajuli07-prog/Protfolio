# Template rendered by scripts/generate-headers.mjs.
{
  auto_https off
  admin off
}
:8080 {
  root * /srv
  import /etc/caddy/headers.caddy
  encode gzip
  @health path /__health
  respond @health 204
  @private path __BASE__/_headers __BASE__/.nojekyll
  respond @private 404
  @immutable path __BASE__/_astro/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  file_server
  handle_errors {
    rewrite * __BASE__/404.html
    file_server
  }
}
