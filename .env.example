# Copy to .env (local only, never commit). All vars optional unless noted.
# Public site URL used for canonical URLs, sitemap, RSS, OG cards.
# No trailing slash.
SITE_URL=http://localhost:4321
# Sub-path if hosted under a subdirectory (e.g. /portfolio). Empty for root.
BASE_PATH=
# Optional privacy-friendly analytics, off by default.
# Reserved for future integration; no analytics script is loaded by the app.
PUBLIC_ANALYTICS_ENABLED=false
# Port for docker prod profile (host side)
PROD_PORT=8080
