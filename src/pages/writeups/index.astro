---
import { getCollection } from 'astro:content';
import { readingTime } from '../../utils/site';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate
);
---

<Base
  title="Writeups — Krish Parajuli"
  description="Lab-only web security notes: methodology, safe validation, remediation."
>
  <h1>Writeups</h1>
  <div class="cards">
    {posts.map((w) => (
      <article class="card">
        <h2>
          <a href={`${import.meta.env.BASE_URL}writeups/${w.id}/`}>{w.data.title}</a>
        </h2>
        <p>
          {w.data.pubDate.toISOString().slice(0, 10)} · {readingTime(w.body ?? '')} min read
        </p>
        <ul class="tags">
          {w.data.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <p>{w.data.description}</p>
      </article>
    ))}
  </div>
</Base>
