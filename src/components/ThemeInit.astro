// Byte-identical to THEME_SCRIPT in scripts/generate-headers.mjs (hash-allowlisted in CSP).
<script
  is:inline
  set:html={
    "try{var t=localStorage.getItem('theme');if(t){document.documentElement.dataset.theme=t}else if(window.matchMedia('(prefers-color-scheme: light)').matches){document.documentElement.dataset.theme='light'}else{document.documentElement.dataset.theme='dark'}}catch(e){}"
  }
/>
